---
import Badge from "@/components/Badge.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import type { PostListItemProps } from "@/types";
import { slugify } from "@/utils/common-utils";

const {
  post,
  class: className,
  hideTags = false,
} = Astro.props as PostListItemProps;
const { title, publishDate, tags = [] } = post.data;
const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 220));
---

<li class:list={[className]}>
  <span class="font-medium"><a href={`/blog/${post.id}/`}>{title}</a></span>
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
    <span class="text-foreground/70 text-sm">
      <FormattedDate date={publishDate} />
      <span class="mx-2" aria-hidden="true">·</span>
      {readingTime} min read
    </span>
    {!hideTags && (
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          {tags.length > 0 &&
            tags.map((tag) => (
              <Badge href={`/tags/${slugify(tag)}/`}>{tag}</Badge>
            ))}
        </div>
      )}
  </div>
</li>
