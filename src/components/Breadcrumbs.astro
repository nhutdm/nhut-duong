---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";
import type { BreadcrumbItem } from "@/types";

type Props = Omit<HTMLAttributes<"nav">, "class"> & {
  items: BreadcrumbItem[];
  class?: string;
};

const { items, class: className, ...props } = Astro.props;
---

<nav aria-label="breadcrumb" class={cn(className)} {...props}>
  <ol
    class="text-muted-foreground flex flex-wrap items-center gap-1.5 text-sm wrap-break-word sm:gap-2.5"
  >
    {items.map((item, index) => (
      <>
        <li class="inline-flex items-center gap-1.5">
          {item.href ? (
            <a href={item.href} class="hover:text-foreground transition-colors">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="text-foreground font-normal">
              {item.label}
            </span>
          )}
        </li>
        {index < items.length - 1 && (
          <li role="presentation" aria-hidden="true" class="[&>svg]:size-3.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </li>
        )}
      </>
    ))}
  </ol>
</nav>
