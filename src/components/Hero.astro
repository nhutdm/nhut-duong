---
import Button from "@/components/Button.astro";
import siteConfig from "@/data/site-config";

const hero = siteConfig.hero;
---

{(hero?.title || hero?.text) && (
    <section>
      {hero.title && (
        <h1 class="font-serif text-[clamp(2.5rem,5vw,4rem)] font-bold tracking-tight">
          {hero.title}
        </h1>
      )}
      {hero.text && (
        <p class="mt-5 text-base leading-relaxed sm:text-lg">{hero.text}</p>
      )}
      {hero.cta && hero.cta.length > 0 && (
        <div class="mt-8 flex flex-wrap items-center gap-3">
          {hero.cta.map((link, index) => (
            <Button
              href={link.href}
              variant={index === 0 ? "primary" : "secondary"}
            >
              {link.text}
            </Button>
          ))}
        </div>
      )}
    </section>
  )}
