---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = Omit<HTMLAttributes<"div">, "class"> & {
  class?: string;
  href?: string;
};

const { href, class: className, ...props } = Astro.props;

const baseClasses =
  "inline-flex items-center rounded-md border border-paper-foreground/20 bg-transparent px-2.5 py-0.5 text-xs font-medium text-paper-foreground/70 transition-colors duration-200";

const linkClasses = cn(
  baseClasses,
  "hover:border-paper-foreground/40 hover:text-paper-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring",
  className,
);
const divClasses = cn(baseClasses, className);
---

{href ? (
    <a href={href} class={linkClasses} {...props}>
      <slot />
    </a>
  ) : (
    <div class={divClasses} {...props}>
      <slot />
    </div>
  )}
