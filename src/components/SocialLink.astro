---
import Icon from "@/components/Icon.astro";
import { cn } from "@/lib/utils";

const { text, href, icon, class: className } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={cn(
    "inline-flex h-9 w-9 items-center justify-center rounded-md transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring",
    className,
  )}
>
  {icon && <Icon icon={icon} class="h-4 w-4 fill-current" />}
  <span class="sr-only">{text} (opens in new tab)</span>
</a>
