---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import Pagination from "@/components/Pagination.astro";
import PostListItem from "@/components/PostListItem.astro";
import siteConfig from "@/data/site-config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { BlogPost } from "@/types";
import { sortItemsByDateDesc } from "@/utils/data-utils";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection("blog")).sort(sortItemsByDateDesc);
  return paginate(posts, { pageSize: 10 });
}

type Props = { page: Page<BlogPost> };

const { page } = Astro.props;
const blog = page.data;
---

<BaseLayout
  title={page.currentPage > 1
      ? `Blog ${siteConfig.titleSeparator} Page ${page.currentPage}`
      : "Blog"}
  description="Insights from a full stack developer and consultant. Explore tech tips, coding journeys, and advice for developers and tech enthusiasts."
>
  <section>
    <h1 class="sig-enter font-serif text-4xl font-bold tracking-tight mb-8">
      Blog
    </h1>
    <ul class="flex flex-col gap-5">
      {blog.map((post, index) => (
        <PostListItem
          post={post}
          class="sig-enter flex flex-col gap-1"
          style={`animation-delay: ${index * 80}ms`}
        />
      ))}
    </ul>
    <Pagination page={page} />
  </section>
</BaseLayout>
