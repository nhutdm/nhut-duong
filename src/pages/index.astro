---
import Layout from "../layouts/Layout.astro";
---

<Layout title="nhut-duong">
  <main
    class="flex min-h-screen items-center justify-center bg-gradient-to-br from-indigo-950 via-slate-900 to-slate-950"
  >
    <section
      class="mx-4 rounded-2xl border border-white/10 bg-white/5 px-10 py-12 text-center shadow-2xl backdrop-blur"
    >
      <h1 class="text-4xl font-bold tracking-tight text-white">nhut-duong</h1>
      <p class="mt-4 text-lg text-slate-300">Built with Astro + Tailwind CSS</p>
    </section>
  </main>
</Layout>
